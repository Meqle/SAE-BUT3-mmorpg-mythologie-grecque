# Copier ce fichier en .env puis changer les mots de passe.
# Le fichier .env n'est jamais commité (voir .gitignore).

# Port du client sur la machine
CLIENT_PORT=8080

# PostgreSQL
POSTGRES_DB=mythologia
POSTGRES_USER=mythologia
POSTGRES_PASSWORD=changez-moi
POSTGRES_PORT=5432

# Secret qui signe les jetons de connexion : une longue chaîne aléatoire (64 caractères).
# Pour en générer un : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire-de-64-caracteres
